# Backend API URL (e.g., https://your-backend.onrender.com/api or /api)
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket Server URL (e.g., https://your-backend.onrender.com)
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (optional, from https://console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
